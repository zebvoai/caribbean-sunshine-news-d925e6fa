{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "dominicanews.dm"
        }
      ],
      "destination": "https://www.dominicanews.dm/:path",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "cat", "value": "(?<cat>[^&]+)" }],
      "destination": "/category/:cat",
      "permanent": true
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "cat", "value": "(?<cat>[^&]+)" }],
      "destination": "/category/:cat",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/mongo-api",
      "destination": "https://xqzffikjyrdmbuptreyj.supabase.co/functions/v1/mongo-api"
    },
    {
      "source": "/api/storage/:bucket/:path*",
      "destination": "https://xqzffikjyrdmbuptreyj.supabase.co/storage/v1/object/public/:bucket/:path*"
    },
    {
      "source": "/api/storage-render/:bucket/:path*",
      "destination": "https://xqzffikjyrdmbuptreyj.supabase.co/storage/v1/render/image/public/:bucket/:path*"
    },
    {
      "source": "/api/auth/token",
      "destination": "https://xqzffikjyrdmbuptreyj.supabase.co/auth/v1/token"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://xqzffikjyrdmbuptreyj.supabase.co/functions/v1/sitemap"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "https://xqzffikjyrdmbuptreyj.supabase.co/functions/v1/news-sitemap"
    },
    {
      "source": "/rss.xml",
      "destination": "https://xqzffikjyrdmbuptreyj.supabase.co/functions/v1/rss"
    },
    {
      "source": "/news/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|slackbot|discordbot|linkedinbot|pinterest|googlebot|google-inspectiontool|storebot-google|bingbot|yandex|baiduspider|applebot|duckduckbot|seznambot|petalbot|bot|crawl|spider|preview"
        }
      ],
      "destination": "/api/og-meta?slug=:slug"
    },
    {
      "source": "/rss/:slug.xml",
      "destination": "https://xqzffikjyrdmbuptreyj.supabase.co/functions/v1/rss?category=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}